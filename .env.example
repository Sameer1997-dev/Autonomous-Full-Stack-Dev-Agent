# Copy these names to your local environment and replace the token value.
AGENT_WEB_TOKEN=replace-with-a-random-secret-at-least-24-characters
AGENT_WEB_PORT=8765
# Optional; Ollama defaults to http://127.0.0.1:11434
# OLLAMA_HOST=http://127.0.0.1:11434
# On Render, commands automatically use Render Sandboxes. Keep these as Render settings/secrets.
# AGENT_EXECUTION_MODE=render
# RENDER_API_KEY=add-in-Render-dashboard-only
# RENDER_SANDBOX_GROUP_ID=sbg-your-group-id
# Optional sandbox compute plan; defaults to 1c-2g.
# RENDER_SANDBOX_PLAN=1c-2g
